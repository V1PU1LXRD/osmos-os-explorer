{
  "name": "osmos-os-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OSMOS — An Interactive Operating-System Concept Explorer. A frontend-only React exhibition of processes, scheduling, memory, deadlock, file systems and system calls.",
  "keywords": [
    "operating-systems",
    "react",
    "education",
    "visualization"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && vite build",
    "preview": "vite preview --port 4173",
    "verify": "node scripts/verify-algorithms.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:all": "npm run verify && npm run verify:responsive && npm run build && npm run verify:layout",
    "perf": "node scripts/measure-perf.mjs",
    "perf:diagnose": "node scripts/diagnose-perf.mjs",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "vite": "^6.0.7"
  }
}
